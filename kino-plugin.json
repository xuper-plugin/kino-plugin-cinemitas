{
  "id": "cinemitas",
  "name": "Cinemitas",
  "version": "0.1.6",
  "apiVersion": 30,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Películas y series de cinemitas.org. Resuelve los hosters con el plugin Kino Resolver.",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-cinemitas",
  "hosts": [
    "cinemitas.org"
  ],
  "streamHosts": "any",
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ],
  "browser": "pages",
  "fetchHosts": "any",
  "capabilities": [
    "search",
    "resolve",
    "episodes",
    "screen"
  ],
  "screen": {
    "label": "Cinemitas",
    "labelEn": "Cinemitas",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsIn": "screen",
    "settingsButton": {
      "label": "Abrir Cinemitas",
      "labelEn": "Open Cinemitas"
    }
  },
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": [
        "resolve"
      ]
    }
  },
  "provides": {
    "catalog": {
      "summary": "Titles this plugin finds, for the author's other plugins",
      "calls": {
        "search": {
          "in": {
            "q": "string",
            "type": "string?"
          },
          "out": "Item[]"
        }
      },
      "types": {
        "Item": {
          "id": "string",
          "ref": "string",
          "title": "string",
          "kind": "string",
          "poster": "string?",
          "backdrop": "string?",
          "year": "string?",
          "overview": "string?",
          "tmdb": "number?"
        }
      }
    }
  },
  "signature": {
    "authorKey": "6693946bd5c56196960959c4b9665fad5094374bcb85ddb282f8bf762c835263",
    "value": "b007d9b614acc5429d87bf8a5e3832121e83213ccfde72aa7d0966ca9e33f4765e78a9132474e8673888c97d50bee0fae436bd1afd8432c11b38b08d8676440c"
  }
}
