{
  "id": "cinemitas",
  "name": "Cinemitas",
  "version": "0.1.11",
  "apiVersion": 30,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Películas y series de cinemitas.org. Resuelve los hosters con el plugin Kino Resolver.",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-cinemitas",
  "hosts": [
    "cinemitas.org"
  ],
  "streamHosts": "any",
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ],
  "browser": "pages",
  "fetchHosts": "any",
  "capabilities": [
    "search",
    "home",
    "resolve",
    "episodes",
    "screen"
  ],
  "screen": {
    "label": "Cinemitas",
    "labelEn": "Cinemitas",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsIn": "screen",
    "settingsButton": {
      "label": "Abrir Cinemitas",
      "labelEn": "Open Cinemitas"
    }
  },
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": [
        "resolve",
        "rank"
      ]
    }
  },
  "provides": {
    "catalog": {
      "summary": "Titles this plugin finds, for the author's other plugins",
      "calls": {
        "search": {
          "in": {
            "q": "string",
            "type": "string?",
            "tmdb": "number?"
          },
          "out": "Item[]"
        },
        "episodes": {
          "in": {
            "ref": "string"
          },
          "out": "Episode[]"
        }
      },
      "types": {
        "Item": {
          "id": "string",
          "ref": "string",
          "title": "string",
          "kind": "string",
          "poster": "string?",
          "backdrop": "string?",
          "year": "string?",
          "overview": "string?",
          "tmdb": "number?"
        },
        "Episode": {
          "season": "number",
          "number": "number",
          "ref": "string",
          "title": "string?"
        }
      }
    }
  },
  "signature": {
    "authorKey": "6693946bd5c56196960959c4b9665fad5094374bcb85ddb282f8bf762c835263",
    "value": "462c9e21235bff5afc5df3a73fa3ee502a8dacbe23e4aec1042cfe40a538e16ec971105d478fe091e2e5ad29053c5e3de0e8d6a22ece6fed118a4dd56a4a0e05"
  }
}
